# ─────────────────────────────────────────────────────────────────────────────
# Frontend (.env in project root)
# Copy this file to .env and fill in your values.
# Variables prefixed VITE_ are exposed to the browser — never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# API base URL — leave empty for local dev (Vite proxy handles /api → :4242)
# Production example: https://api.whispycv.cz
VITE_API_BASE_URL=
