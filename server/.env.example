# ─────────────────────────────────────────────────────────────────────────────
# Backend (server/.env)
# Copy this file to server/.env and fill in your values.
# Never commit this file — it contains your Stripe secret key.
# ─────────────────────────────────────────────────────────────────────────────

# Stripe secret key — NEVER expose this in the browser
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Pre-created Price ID from your Stripe dashboard (one-time, CZK)
# https://dashboard.stripe.com/products
STRIPE_PRICE_ID=price_REPLACE_ME

# Webhook signing secret — get it from:
#   stripe listen --forward-to localhost:4242/api/webhook
# Leave empty to skip webhook signature check in dev
STRIPE_WEBHOOK_SECRET=

# Where Stripe redirects after payment
# {CHECKOUT_SESSION_ID} is a Stripe template literal — keep it exactly as-is
STRIPE_SUCCESS_URL=http://localhost:5173/?payment=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/?payment=cancelled

# Allowed CORS origin (your frontend URL)
CLIENT_URL=http://localhost:5173

# Express server port
PORT=4242
